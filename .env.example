# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=tiktok_live_reporter

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Groq AI API Key (for OCR screenshot analysis)
# Dapatkan API key di https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here

# API Satupintu (untuk leads sosial media)
SATUPINTU_API_URL=https://api.satupintu.mendunia.id
SATUPINTU_API_TOKEN=your_token_here
